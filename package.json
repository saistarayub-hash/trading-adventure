{
  "name": "trading-tutor",
  "version": "1.1.0",
  "description": "Professor Fox \u2014 learn trading the easy way \u2014 plus the Trading Companion: an always-on-top desktop coach that learns from the videos and links you feed it and teaches you live on your screen.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "companion": "npm --prefix companion start",
    "companion:install": "npm --prefix companion install",
    "test": "node test.js && node test-companion.js",
    "demo:seed": "node tools/seed-demo.js",
    "icons": "node tools/make-icons.js",
    "companion:dist": "npm --prefix companion run dist",
    "companion:dist:win": "npm --prefix companion run dist:win",
    "companion:dist:mac": "npm --prefix companion run dist:mac",
    "companion:dist:linux": "npm --prefix companion run dist:linux"
  },
  "dependencies": {},
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
